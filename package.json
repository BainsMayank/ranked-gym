{
  "name": "ranked-gym",
  "version": "0.1.0",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^0.45.3",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.3",
    "react-native-worklets": "0.10.1",
    "victory-native": "^42.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "supabase": "^2.119.0",
    "tailwindcss": "^3.4.19",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "integrity": "node scripts/check-integrity.cjs && node --disable-warning=ExperimentalWarning scripts/check-sqlite.cjs",
    "check": "pnpm integrity && pnpm peers check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "expo:doctor": "npx expo-doctor",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:remote": "supabase test db --linked",
    "db:types": "node scripts/db-types.cjs --local",
    "db:types:remote": "node scripts/db-types.cjs --linked",
    "db:types:check": "node scripts/db-types.cjs --local --check",
    "db:push": "supabase db push",
    "db:local:generate": "drizzle-kit generate",
    "exercises:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/seed/build.ts",
    "standards:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/seed/buildStandards.ts",
    "ranks:fake": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/seed/buildFakeUsers.ts",
    "dev:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/seed/buildDevSeed.ts",
    "leagues:simulate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/seed/simulateLeagues.ts",
    "social:acceptance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/seed/socialAcceptance.ts"
  },
  "private": true
}
