# Copy to .env and fill in from Supabase → Project Settings → API.
# Read in app.config.ts and exposed to the app via expo-constants (extra).
# Simulator against the local stack: SUPABASE_URL=http://127.0.0.1:54321 and the anon key from
# `pnpm exec supabase status`. A real phone needs the hosted project.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Development builds skip login and onboarding by default, including after emulator restarts.
# A saved session is still restored. Without one, the app opens in account-free preview mode;
# server-backed account features still need a real sign-in. Release builds ignore this switch.
# Set false and restart Expo to test the normal login and onboarding flow.
EXPO_PUBLIC_DEV_AUTH_BYPASS=true
